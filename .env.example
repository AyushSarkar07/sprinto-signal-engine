# --- Claude (AI extraction, pain points, email writing) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Contact discovery ---
HUNTER_API_KEY=
HUNTER_MAX_CALLS_PER_RUN=10
CONTACT_PROVIDERS=hunter,manual,website

# --- Gmail API (OAuth desktop client) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_TOKEN_PATH=credentials/token.json

# --- Optional SMTP alternative (EMAIL_BACKEND=smtp) ---
EMAIL_BACKEND=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=

# --- Test-send safety: the ONLY address that can ever receive mail ---
TEST_TO_EMAIL=
SENDER_NAME=

# --- Behaviour ---
DRY_RUN=true
# Human review gate: every draft must be approved (python main.py --approve "Company") before it can be sent.
REVIEW_GATE=true
LOG_LEVEL=INFO
MAX_SECONDARY_RESEARCH_ROUNDS=2
INITIAL_PAGE_BUDGET=4
RESEARCH_PAGE_BUDGET=4
REQUEST_DELAY_SECONDS=1.0
REQUEST_TIMEOUT_SECONDS=15
USE_PLAYWRIGHT=false

# --- Optional external discovery (pluggable; pipeline works without it) ---
SEARCH_PROVIDER=
SERPER_API_KEY=
